-- A small standard library of Church encodings.
-- Load it with `levy examples/prelude.lam` or `:load examples/prelude.lam`.

id    = \x. x
const = \x y. x
compose = \f g x. f (g x)

-- Booleans
true  = \a b. a
false = \a b. b
not   = \p a b. p b a
and   = \p q. p q p
or    = \p q. p p q

-- Pairs
pair = \a b s. s a b
fst  = \p. p true
snd  = \p. p false

-- Numerals: `n f x` applies `f` to `x` n times
succ   = \n f x. f (n f x)
plus   = \m n f x. m f (n f x)
times  = \m n f. m (n f)
power  = \m n. n (times m) 1   -- `n m` alone gives `\x. x` for `m^0`, not 1
iszero = \n. n (\x. false) true
pred   = \n f x. n (\g h. h (g f)) (\u. x) (\u. u)
minus  = \m n. n pred m

-- Comparison of numerals: `minus` stops at 0, so `m - n` is 0 when m <= n
leq = \m n. iszero (minus m n)
geq = \m n. leq n m
lt  = \m n. not (geq m n)
gt  = \m n. not (leq m n)
eq  = \m n. and (leq m n) (geq m n)
neq = \m n. not (eq m n)

-- Recursion
fix  = \f. (\x. f (x x)) (\x. f (x x))
fact = fix (\self n. iszero n 1 (times n (self (pred n))))
fib  = \n. fst (n (\p. pair (snd p) (plus (fst p) (snd p))) (pair 0 1))
